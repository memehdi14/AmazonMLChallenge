output/
artefacts/
artifacts/
handoff/
logs/
*.log
*.pkl

# Python cache and environments
__pycache__/
*.py[cod]
*.class
.pytest_cache/
venv/
env/
.venv/
.env

# System and OS files
.DS_Store
__MACOSX/
Thumbs.db
.idea/
.vscode/
